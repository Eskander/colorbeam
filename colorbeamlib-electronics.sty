%
%  colorbeam library: electronics
%  CircuiTikZ (european style), the \ohm symbol and TikZ styles for
%  boards and wiring diagrams. Load it with
%
%     \usecolorbeamlibrary{electronics}
%
%  TikZ styles: wire (thick rounded wire), board (dark module such as an
%  ESP32 or Arduino), pinc (pin dot), pinl (pin label).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{colorbeamlib-electronics}[2026/11/14 v1.2 colorbeam electronics library]
\@ifpackageloaded{beamerthemecolorbeam}{}{%
  \PackageError{colorbeamlib-electronics}{The colorbeam theme is not loaded}{%
    Put \string\usetheme{colorbeam} before loading this library.}}

\RequirePackage[european]{circuitikz}

\newcommand{\ohm}{\ensuremath{\Omega}}

\tikzset{
  wire/.style={line width=2.2pt,line cap=round},                          % wire
  board/.style={fill=ink,rounded corners=5pt},                            % electronic board (ESP32, Arduino...)
  pinc/.style={fill=white,draw=none},                                     % pin
  pinl/.style={anchor=west,text=white,font=\footnotesize\bfseries},       % pin label
}
\endinput
